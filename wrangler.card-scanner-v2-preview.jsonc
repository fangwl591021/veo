{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veo-card-scanner-v2-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/v1/*", "/i/*", "/w/*", "/c/*", "/r/*", "/akaffit-official", "/akaffit-official-runtime", "/akaffit-official-slick.js", "/akaffit-official-slick.css", "/akaffit-official-slick-theme.css", "/akaffit-official-font/*", "/admin", "/admin/*", "/admin.html", "/assets/checkin-template/*"]
  },
  "vars": {
    "LIFF_ID": "2010657278-VqB7uA2y",
    "CARD_SHARE_LIFF_ID": "2010657278-blC5Mnqg",
    "CHECKIN_LIFF_ID": "2010657278-VqB7uA2y",
    "LINE_LOGIN_CHANNEL_ID": "2010657278",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "OPENAI_FALLBACK_MODEL": "gpt-5-mini",
    "PUBLIC_APP_URL": "https://veo.fangwl591021.workers.dev/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veo_crm",
      "database_id": "56e092af-1669-48c6-bbfd-06f266237acb",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "veo-media"
    }
  ]
}
