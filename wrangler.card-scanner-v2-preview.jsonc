{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akaffit-team",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/v1/*", "/i/*", "/w/*", "/c/*", "/r/*", "/akaffit-official", "/akaffit-official-runtime", "/akaffit-official-slick.js", "/akaffit-official-slick.css", "/akaffit-official-slick-theme.css", "/akaffit-official-font/*", "/admin", "/admin/*", "/admin.html", "/assets/checkin-template/*"]
  },
  "vars": {
    "LIFF_ID": "2010925044-wsFOgzH2",
    "CARD_SHARE_LIFF_ID": "2010925044-hPtKkoKO",
    "CHECKIN_LIFF_ID": "2010925044-KXzQzB5r",
    "LINE_LOGIN_CHANNEL_ID": "2007221311",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "OPENAI_FALLBACK_MODEL": "gpt-5-mini"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akaffit_team_crm",
      "database_id": "62f1b387-b6b7-40a3-9c57-97c5c056428a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "services": [
    {
      "binding": "MLM_WORKER",
      "service": "mlm"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "akaffit-team-media"
    }
  ]
}
